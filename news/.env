# ─────────────────────────────────────────────────────────────
#  BIC News — Environment Variables
#  Copy this file to ".env" and fill in your own values.
#  Never commit the real ".env" file to version control.
# ─────────────────────────────────────────────────────────────

# The password used to log in to the admin panel.
# Use something long and hard to guess.
ADMIN_PASSWORD=admin123

# A long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=5236cb35ff9307f8e53f3fb8dc8ed6d99ad4ccef05464be15bea661698f8e9c9

# Port the server listens on (default: 3000)
PORT=3000

# Set to "production" on your live server to enable secure cookies (requires HTTPS)
NODE_ENV=development
