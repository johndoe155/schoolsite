# Build context for the site image (root Dockerfile). The compose file builds it
# from the repository root, so without this the daemon is sent the entire portal
# monorepo — node_modules, .next, dist — none of which the site image uses.
node_modules
**/node_modules
portal
.git
.github
.env
.env.*
*.log
*.tmp
.cache_build
.vercel
.next
dist
coverage

# Runtime state is baked into the image empty and mounted as a volume. Shipping
# whatever a developer happens to have in data/ would leak local test posts and
# uploads into production.
#
# data/gallery-data.json and data/news/config.json are deliberately NOT
# excluded: they are curated site content and configuration, not runtime state.
# Excluding the gallery was a mistake — the Dockerfile copies data/, so a fresh
# deploy would seed its volume from an image with no gallery and the homepage
# would report "No gallery items yet" over 131 images that do exist.
data/news/sessions
data/library/catalog.json
data/news/posts.json
