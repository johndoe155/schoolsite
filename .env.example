# ─────────────────────────────────────────────────────────────
#  BIC unified site — environment variables
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit the real ".env" file to version control.
# ─────────────────────────────────────────────────────────────

# Port the server listens on (default: 4040)
PORT=4040

# Set to "production" on your live server (enables secure session cookies —
# requires HTTPS).
NODE_ENV=development

# ── Gallery staff admin (admin.html) ─────────────────────────
# Password for the gallery management panel. Use something long.
ADMIN_TOKEN=change-me-gallery-token

# ── Contact form (SMTP via nodemailer) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TO_EMAIL=

# ── News admin (news.html staff panel) ───────────────────────
NEWS_ADMIN_PASSWORD=change-me-news-password

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── Digital library staff uploads (library.html) ─────────────
STAFF_PASSCODE=change-me-library-passcode

# ── Optional: CORS allow-list for the /api/* endpoints ──────
# Same-origin requests are always allowed. Comma-separated origins:
# ALLOWED_ORIGINS=https://example.com,https://other.example.org
