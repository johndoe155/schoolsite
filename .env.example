# ─────────────────────────────────────────────────────────────
#  BIC unified site — environment variables
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit the real ".env" file to version control.
# ─────────────────────────────────────────────────────────────

# Port the server listens on (default: 4040)
PORT=4040

# Set to "production" on your live server (enables secure session cookies —
# requires HTTPS).
NODE_ENV=development

# ── Gallery staff admin (admin.html) ─────────────────────────
# Password for the gallery management panel. Use something long.
ADMIN_TOKEN=change-me-gallery-token

# ── Contact form (SMTP via nodemailer) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TO_EMAIL=

# ── News admin (news.html staff panel) ───────────────────────
NEWS_ADMIN_PASSWORD=change-me-news-password

# ── Newsletter (subscribe, send, unsubscribe) ────────────────
# Signs the unsubscribe link that goes out in every newsletter. If it is not
# set the site falls back to SESSION_SECRET; if neither is set the links break
# on the next restart. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEWSLETTER_SECRET=
# The public address of the site, used to build unsubscribe links when the
# server sits behind a proxy. Example: https://bodijainternationalcollege.com
PUBLIC_ORIGIN=

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── Digital library staff uploads (library.html) ─────────────
STAFF_PASSCODE=change-me-library-passcode

# ── Optional: CORS allow-list for the /api/* endpoints ──────
# Same-origin requests are always allowed. Comma-separated origins:
# ALLOWED_ORIGINS=https://example.com,https://other.example.org

# ─────────────────────────────────────────────────────────────
#  PORTAL  —  see PORTAL-INTEGRATION-PLAN.md
#  The portal is a separate Next.js + NestJS monorepo under portal/.
#  server.js is the single public door and proxies /portal to it, so
#  these are read by server.js and by scripts/portal.js.
#
#  The portal itself has ~64 variables of its own; the full reference
#  is portal/.env.example. Only these affect the site's proxy layer.
# ─────────────────────────────────────────────────────────────

# Set to "false" to run the marketing site alone. The portal links then
# return a 502 page instead of the server failing to boot.
PORTAL_ENABLED=true

# Where the two portal processes listen. Leave as-is unless they clash.
PORTAL_WEB_URL=http://127.0.0.1:3000
PORTAL_API_URL=http://127.0.0.1:8080

# The origin browsers actually reach the portal on. MUST carry the /portal
# suffix: every emailed link and the Paystack callback_url are built from it,
# and it must be set on the API *and* the worker or parents get dead links.
# In production this must be a real https:// host — the API refuses to boot
# on a loopback address.
PUBLIC_WEB_ORIGIN=http://localhost:4040/portal

# ── Portal development defaults (scripts/portal.js) ──────────
# SEED_DEMO=true loads a demo roster. Set false for a real school.
# DATABASE_URL is REQUIRED in production — without it the API throws on
# boot rather than falling back to in-memory PGlite.
# SEED_DEMO=true
# COOKIE_SECURE=false
# DATABASE_URL=postgres://portal_owner:CHANGE_ME@host:5432/portal
# APP_SECRET=                # >=32 chars in production
# SMTP_URL=                  # required in production; smtps://user:pass@host:465
